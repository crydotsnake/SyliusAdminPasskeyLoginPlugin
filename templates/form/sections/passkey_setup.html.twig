{% set resource = hookable_metadata.context.resource %}
{% set is_own_account = app.user is not null and resource.id is not null and resource.id == app.user.id %}

<div class="card mb-3" data-live-ignore>
    <div class="card-header">
        <div class="card-title">
            {{ 'skrull_sylius_admin_passkey_login.ui.passkeys'|trans }}
        </div>
    </div>
    <div class="card-body">
        {% if not is_own_account %}
            <p class="text-secondary mb-0">
                {{ ux_icon('tabler:user-key', {class: 'icon'}) }}
                {{ 'skrull_sylius_admin_passkey_login.ui.only_own_account'|trans }}
            </p>
        {% else %}
            {% set passkeys = skrull_admin_passkeys(resource) %}

            <div
                data-skrull-passkey
                data-options-url="{{ path('webauthn.controller.creation.request.skrull_admin_passkey') }}"
                data-result-url="{{ path('webauthn.controller.creation.response.skrull_admin_passkey') }}"
                data-message-unsupported="{{ 'skrull_sylius_admin_passkey_login.ui.error_unsupported'|trans }}"
                data-message-cancelled="{{ 'skrull_sylius_admin_passkey_login.ui.error_cancelled'|trans }}"
                data-message-already-registered="{{ 'skrull_sylius_admin_passkey_login.ui.error_already_registered'|trans }}"
                data-message-generic="{{ 'skrull_sylius_admin_passkey_login.ui.error_generic'|trans }}"
            >
                <p class="text-secondary">
                    {{ 'skrull_sylius_admin_passkey_login.ui.intro'|trans }}
                </p>

                {% if passkeys is not empty %}
                    <div class="table-responsive mb-3">
                        <table class="table table-vcenter">
                            <thead>
                                <tr>
                                    <th>{{ 'sylius.ui.name'|trans }}</th>
                                    <th>{{ 'skrull_sylius_admin_passkey_login.ui.created_at'|trans }}</th>
                                    <th>{{ 'skrull_sylius_admin_passkey_login.ui.last_used_at'|trans }}</th>
                                    <th class="w-1"><span class="visually-hidden">{{ 'sylius.ui.actions'|trans }}</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for passkey in passkeys %}
                                    <tr>
                                        <td class="fw-bold">
                                            {{ passkey.name ?? 'skrull_sylius_admin_passkey_login.ui.unnamed_passkey'|trans }}
                                        </td>
                                        <td class="text-secondary text-nowrap">
                                            {{ passkey.createdAt|date('d-m-Y H:i') }}
                                        </td>
                                        <td class="text-secondary text-nowrap">
                                            {{ passkey.lastUsedAt is not null ? passkey.lastUsedAt|date('d-m-Y H:i') : 'skrull_sylius_admin_passkey_login.ui.never_used'|trans }}
                                        </td>
                                        <td>
                                            <div class="btn-list flex-nowrap justify-content-end">
                                                <a
                                                    href="{{ path('skrull_sylius_admin_passkey_login_admin_passkey_rename', {id: passkey.id}) }}"
                                                    class="btn btn-ghost-primary btn-sm"
                                                >
                                                    {{ ux_icon('tabler:pencil', {class: 'icon'}) }}
                                                    {{ 'skrull_sylius_admin_passkey_login.ui.rename'|trans }}
                                                </a>
                                                <button
                                                    type="button"
                                                    class="btn btn-ghost-danger btn-sm"
                                                    data-skrull-passkey-delete
                                                    data-url="{{ path('skrull_sylius_admin_passkey_login_admin_passkey_delete', {id: passkey.id}) }}"
                                                    data-csrf-token="{{ csrf_token('skrull_admin_passkey_delete_' ~ passkey.id) }}"
                                                    data-confirm="{{ 'skrull_sylius_admin_passkey_login.ui.delete_confirm'|trans({'%name%': passkey.name ?? 'skrull_sylius_admin_passkey_login.ui.unnamed_passkey'|trans}) }}"
                                                >
                                                    {{ ux_icon('tabler:trash', {class: 'icon'}) }}
                                                    {{ 'skrull_sylius_admin_passkey_login.ui.delete'|trans }}
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}

                <div class="input-group">
                    <input
                        type="text"
                        class="form-control"
                        maxlength="100"
                        placeholder="{{ 'skrull_sylius_admin_passkey_login.ui.name_placeholder'|trans }}"
                        aria-label="{{ 'skrull_sylius_admin_passkey_login.ui.name_placeholder'|trans }}"
                        data-skrull-passkey-name
                    >
                    <button type="button" class="btn btn-primary" data-skrull-passkey-add>
                        {{ ux_icon('tabler:plus', {class: 'icon'}) }}
                        {{ 'skrull_sylius_admin_passkey_login.ui.add_passkey'|trans }}
                    </button>
                </div>

                <div class="alert alert-danger mt-3 mb-0 d-none" role="alert" data-skrull-passkey-error></div>
            </div>
        {% endif %}
    </div>
</div>
