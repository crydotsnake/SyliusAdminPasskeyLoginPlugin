{
    "name": "skrull/sylius-admin-passkey-login-plugin",
    "type": "sylius-plugin",
    "description": "Passkey (WebAuthn) login support for Sylius administrators",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "test-application",
        "passkey",
        "webauthn",
        "fido2"
    ],
    "authors": [
        {
          "name": "Simon Krull"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "sylius/grid-bundle": "^1.16.1",
        "sylius/sylius": "^2.1",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/security-csrf": "^7.4 || ^8.0",
        "symfony/security-http": "^7.4 || ^8.0",
        "symfony/uid": "^7.4 || ^8.0",
        "web-auth/webauthn-lib": "^5.3.9",
        "web-auth/webauthn-symfony-bundle": "^5.3.9"
    },
    "require-dev": {
        "madewithlove/license-checker": "^3.2",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "sylius-labs/coding-standard": "^4.5",
        "sylius/sylius-rector": "^3.0",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/debug-bundle": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/intl": "^7.4 || ^8.0",
        "symfony/runtime": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "rector/extension-installer": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1-dev"
        },
        "symfony": {
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "SKrull\\SyliusAdminPasskeyLoginPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\SKrull\\SyliusAdminPasskeyLoginPlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "scripts": {
        "analyze": "phpstan analyse -c phpstan.neon",
        "check-license": "license-checker check",
        "cs-check": "ecs check",
        "cs-fix": "ecs check --fix",
        "cs-twig": "twig-cs-fixer lint",
        "cs-twig-fix": "twig-cs-fixer lint --fix",
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migration:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    }
}
